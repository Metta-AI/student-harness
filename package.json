    "@assistant-ui/react": "^0.15.22",
    "@assistant-ui/react-generative-ui": "^0.0.21",
    "@assistant-ui/react-markdown": "^0.14.17",
    "@assistant-ui/react-streamdown": "^0.3.17",
    "@observablehq/plot": "^0.6.17",
    "@streamdown/code": "^1.1.1",
    "@supabase/supabase-js": "^2.117.2",
    "@vercel/sandbox": "3.5.1",
    "ai": "^7.0.123",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "eve": "0.68.0",
    "fix-webm-duration": "^1.0.6",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "posthog-js": "^1.435.5",
    "posthog-node": "^5.55.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.1",
    "remark-gfm": "^4.0.1",
