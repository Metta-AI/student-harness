# 32 random bytes as hex. Seals the student cookie and the stored Softmax tokens.
SESSION_SECRET=replace-with-64-hex-characters
# Preston uses Vercel AI Gateway. Optional API key; otherwise uses project OIDC below.
AI_GATEWAY_API_KEY=
# Supabase, provisioned through the Vercel marketplace (`vercel integration add supabase`).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL=
# AI Gateway and Sandbox credentials for local development. Refresh with `vercel env pull` when expired.
VERCEL_OIDC_TOKEN=
SOFTMAX_API_URL=https://softmax.com/api
# PostHog product analytics (client and server).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
