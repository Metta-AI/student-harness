{
  "name": "student-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "desktop": "node desktop/scripts/launch.mjs",
    "desktop:dev": "node desktop/scripts/launch.mjs --dev",
    "desktop:package": "npm --prefix desktop run package",
    "desktop:test": "npm --prefix desktop test && node desktop/tests/smoke.mjs && node desktop/tests/replay-sync-smoke.mjs && node desktop/tests/replay-sync-smoke.mjs --transport-only && node desktop/tests/companion-notices-smoke.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-test-module-mocks --test tests/*.test.mjs",
    "test:semantic": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --test tests/semantic-ir.test.mjs tests/policy-metrics.test.mjs",
    "eve:dev": "eve dev",
    "eve:info": "eve info",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate-db.mjs",
    "test:browser": "node tests/browser/research.mjs",
    "test:runtime": "node tests/runtime/continuity.mjs",
    "test:runtime:game-tools": "node tests/runtime/game-tools.mjs",
    "test:runtime:connections": "node tests/runtime/tool-connections.mjs",
    "test:runtime:connections:background": "node tests/runtime/tool-connections.mjs --background",
    "test:runtime:connections:live": "node --env-file-if-exists=.env.local tests/runtime/tool-connections.mjs --background --live",
    "test:runtime:continuity:live": "node --env-file-if-exists=.env.local tests/runtime/continuity-quality.mjs --live",
    "test:runtime:scheduling": "node tests/runtime/scheduling.mjs",
    "test:runtime:native:live": "node --env-file-if-exists=.env.local tests/runtime/native-lifecycle.mjs --live",
    "research:dev": "node scripts/research-dev-scheduler.mjs",
    "research:status": "node --env-file=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/campaign-status.mjs",
    "test:runtime:replay-vision:live": "node --env-file-if-exists=.env.local tests/runtime/replay-vision.mjs --live",
    "test:vision:live": "node --env-file-if-exists=.env.local tests/runtime/vision.mjs",
    "test:runtime:cloud-browser": "node tests/runtime/cloud-browser.mjs",
    "test:runtime:cloud-browser:live": "node --env-file-if-exists=.env.local tests/runtime/cloud-browser-live.mjs --live",
    "test:runtime:browser-session:live": "node --env-file-if-exists=.env.local tests/runtime/browser-session.mjs --live",
    "test:runtime:desktop-session:live": "node --env-file-if-exists=.env.local tests/runtime/browser-session.mjs --live --desktop",
    "test:runtime:desktop-lifecycle:live": "node --env-file-if-exists=.env.local tests/runtime/desktop-lifecycle-live.mjs --live",
    "test:runtime:desktop-failure:live": "node --env-file-if-exists=.env.local tests/runtime/desktop-agent.mjs --live --supervisor-failure",
    "test:runtime:desktop-agent:live": "node --env-file-if-exists=.env.local tests/runtime/desktop-agent.mjs --live",
    "test:runtime:desktop:live": "node --env-file-if-exists=.env.local tests/runtime/virtual-desktop-live.mjs --live",
    "test:runtime:browser-agent:live": "node --env-file-if-exists=.env.local tests/runtime/browser-agent.mjs --live",
    "test:runtime:procedure-trials:live": "node --env-file-if-exists=.env.local tests/runtime/procedure-discovery.mjs --live --investigator",
    "test:runtime:procedures:live": "node --env-file-if-exists=.env.local tests/runtime/procedure-discovery.mjs --live",
    "test:voice:connections:live": "RUN_LIVE_VOICE_CONNECTION_EVAL=1 node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types --experimental-test-module-mocks --test tests/voice-connections.test.mjs",
    "test:runtime:campaign-submission:flow": "node tests/runtime/session-control.mjs --submission-flow",
    "test:runtime:campaign-submission": "node tests/runtime/session-control.mjs --submission",
    "test:runtime:session-control": "node tests/runtime/session-control.mjs",
    "test:runtime:session-control:live": "node --env-file-if-exists=.env.local tests/runtime/session-control.mjs --live",
    "test:browser:session-control": "node tests/browser/session-control-refresh.mjs",
    "test:runtime:desktop-control": "node tests/runtime/session-control.mjs --desktop",
    "test:runtime:learning-lineage": "node tests/runtime/session-control.mjs --learning",
    "test:runtime:computer-reviews": "node tests/runtime/session-control.mjs --computer-reviews",
    "test:runtime:voice-audio:live": "node --env-file-if-exists=.env.local tests/runtime/browser-session.mjs --live --voice-audio",
    "test:runtime:voice-computer:live": "node --env-file-if-exists=.env.local tests/runtime/browser-session.mjs --live --voice-reviews",
    "test:runtime:voice-computer": "node tests/runtime/session-control.mjs --voice-computer",
    "test:runtime:campaign-memory": "node tests/runtime/session-control.mjs --memory",
    "test:runtime:model-usage": "node tests/runtime/session-control.mjs --usage",
    "test:browser:desktop-activity": "node tests/browser/desktop-activity.mjs",
    "test:runtime:voice-audio:quota": "node tests/runtime/browser-session.mjs --voice-audio --quota-fixture",
    "test:runtime:learning-quality:live": "node --env-file-if-exists=.env.local tests/runtime/session-control.mjs --learning-quality --live",
    "postinstall": "node scripts/patch-eve.mjs",
    "prebuild": "node scripts/patch-eve.mjs",
    "predev": "node scripts/patch-eve.mjs",
    "pretest": "node scripts/patch-eve.mjs",
    "test:runtime:findings": "node tests/runtime/session-control.mjs --findings",
    "test:runtime:study-followups:workflow": "node tests/runtime/session-control.mjs --study-followup-workflow",
    "test:runtime:study-followups": "node tests/runtime/session-control.mjs --study-followups",
    "test:runtime:study-followups:live": "node --env-file-if-exists=.env.local tests/runtime/session-control.mjs --study-followup-workflow --live",
    "test:runtime:evaluation-export": "node tests/runtime/session-control.mjs --evaluation-export",
    "assess:learning": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/assess-learning-case.mjs",
    "test:runtime:evaluation-assessment:live": "node --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types tests/runtime/evaluation-assessment.mjs --live",
    "test:runtime:generic-learning": "node tests/runtime/session-control.mjs --generic-learning",
    "test:runtime:generic-reviews": "node tests/runtime/session-control.mjs --study-followup-workflow --generic",
    "test:runtime:generic-reviews:closure": "node tests/runtime/session-control.mjs --study-followup-workflow --generic-closure"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Metta-AI/student-harness.git"
